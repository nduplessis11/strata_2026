{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "gcc-debug",
      "displayName": "GCC Debug (gnu++23)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "STRATA_USE_GNU_EXTENSIONS": "ON",
        "STRATA_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc-release",
      "displayName": "GCC Release (gnu++23)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "STRATA_USE_GNU_EXTENSIONS": "ON",
        "STRATA_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw64-release",
      "displayName": "MinGW-w64 Release (Windows x64) (WSL host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw64.cmake",
        "STRATA_USE_GNU_EXTENSIONS": "ON",
        "STRATA_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "mingw64-debug",
      "displayName": "MinGW-w64 Debug (Windows x64) (WSL host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw64.cmake",
        "STRATA_USE_GNU_EXTENSIONS": "ON",
        "STRATA_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC Debug (Windows)",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/msvc-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "STRATA_WARNINGS": "ON",
        "STRATA_USE_GNU_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC Release (Windows)",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/out/build/msvc-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "STRATA_WARNINGS": "ON",
        "STRATA_USE_GNU_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "win-mingw64-debug",
      "displayName": "MinGW-w64 Debug (Windows host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/win-mingw64-debug",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc",
        "STRATA_USE_GNU_EXTENSIONS": "ON",
        "STRATA_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "win-mingw64-release",
      "displayName": "MinGW-w64 Release (Windows host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/win-mingw64-release",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_C_COMPILER": "gcc",
        "STRATA_USE_GNU_EXTENSIONS": "ON",
        "STRATA_WARNINGS": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc-debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc-release"
    },
    {
      "name": "mingw64-debug",
      "configurePreset": "mingw64-debug"
    },
    {
      "name": "mingw64-release",
      "configurePreset": "mingw64-release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc-debug",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc-release",
      "configuration": "Release"
    },
    {
      "name": "win-mingw64-debug",
      "configurePreset": "win-mingw64-debug"
    },
    {
      "name": "win-mingw64-release",
      "configurePreset": "win-mingw64-release"
    }
  ]
}
